# ─── SECURITY — never commit these ─────────────────────────────────────────────
.env
.env.local
data/cookies.json
data/.browser-profile/
data/uploads/
data/profiles.json

# ─── Private business data ─────────────────────────────────────────────────────
# Recorded paths contain product descriptions, manufacturer details, MRPs etc.
# Used SKUs reveal listing volume. Both stay local.
paths/*
!paths/.gitkeep
data/used_skus.json

# ─── Image generation (background swap) ────────────────────────────────────────
# (inline comments are NOT allowed on pattern lines — git treats them as part of
#  the pattern — so each note goes on its own line above the pattern.)
# ephemeral per-batch composites
data/generated/
# remote-downloaded Transformers.js model cache
data/.models/
# locally-staged RMBG-1.4 model (large binary)
data/.models-local/
# all background plates + scenes (procedurally generated, self-heal on run)
assets/

# ─── Dependencies ───────────────────────────────────────────────────────────────
node_modules/

# ─── Build output ───────────────────────────────────────────────────────────────
dist/

# ─── OS noise ───────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ─── Playwright browser cache ───────────────────────────────────────────────────
playwright-report/
test-results/

# ─── Editor noise ──────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp

# ─── Claude Code local config ──────────────────────────────────────────────────
.claude/
